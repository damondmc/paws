Bootstrap: docker
From: ubuntu:22.04

%environment
    export PATH="/opt/paws/.venv/bin:$PATH"
    export VIRTUAL_ENV="/opt/paws/.venv"

%post
    set -e
    # 1. Added ca-certificates so curl and git can use SSL/HTTPS safely
    apt-get update -y
    apt-get install -y --no-install-recommends build-essential curl git python3 python3-dev ca-certificates

    # 2. Install uv
    curl -LsSf https://astral.sh/uv/install.sh | sh

    # 3. Clone and sync cleanly; the dependencies include lalsuite, so /opt/paws/.venv/bin holds lalpulsar_Weave and
    #    lalpulsar_WeaveSetup, the executables of environment.yaml when its paths are null
    git clone https://github.com/damondmc/paws /opt/paws
    cd /opt/paws
    /root/.local/bin/uv sync --frozen --no-dev --no-editable --compile-bytecode --no-cache

    # 4. Housekeeping
    rm -rf /opt/paws/.git
    rm -rf /root/.local/bin/uv
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%test
    lalpulsar_Weave --version
    lalpulsar_WeaveSetup --version
    paws --help
